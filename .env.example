# Copy to .env and fill in your values; never commit .env.
ENVIRONMENT=local
LOG_LEVEL=INFO

# --- Database and Redis
# Containers reach PostgreSQL on the Windows host through host.docker.internal.
# For Python run on the host, use localhost instead (and localhost for Redis).
# Runtime login used by the API.
DATABASE_URL=postgresql+asyncpg://frontdesk_app:REPLACE_WITH_RUNTIME_PASSWORD@host.docker.internal:5432/frontdesk
# Schema owner; given only to the migration job and operator commands.
MIGRATION_DATABASE_URL=postgresql+asyncpg://postgres:REPLACE_WITH_OWNER_PASSWORD@host.docker.internal:5432/frontdesk
# Separate login for the background worker; never reuse the API or owner login.
WORKER_DATABASE_URL=postgresql+asyncpg://frontdesk_worker:REPLACE_WITH_WORKER_PASSWORD@host.docker.internal:5432/frontdesk
REDIS_URL=redis://redis:6379/0
# Connections per process: up to DB_POOL_SIZE + DB_MAX_OVERFLOW.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DEPENDENCY_TIMEOUT_SECONDS=2

# --- First super admin. Read only by the setup job; an existing account is never changed.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=Super Admin

# --- Keys. Inject from the deployment secret manager; required once deployed.
# Keyring for encrypted database fields: JSON {"key-id": "<base64 of 32 random bytes>"}.
# Generate a key: python -c "import base64,secrets;print(base64.b64encode(secrets.token_bytes(32)).decode())"
# Keep retired key IDs until nothing uses them; losing a key loses what it encrypted.
SECRET_ENCRYPTION_KEYS=
SECRET_ENCRYPTION_ACTIVE_KEY=
# Independent random values: python -c "import secrets;print(secrets.token_urlsafe(48))"
OTP_HMAC_KEY=
STREAM_TOKEN_KEY=

# --- Public addresses
# Frontend origin used in emailed links (HTTPS outside local/development).
TENANT_AUTH_PUBLIC_ORIGIN=
# Public HTTPS origin for Twilio webhooks, no trailing slash. Calls are answered once set.
TELEPHONY_PUBLIC_BASE_URL=
# How long a platform administrator stays signed in.
PLATFORM_SESSION_MINUTES=30

# --- Email (invitations and password reset, sent by the worker)
SMTP_HOST=
SMTP_PORT=587
# starttls | tls | plain (plain is accepted only in local/development)
SMTP_TLS_MODE=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER=

# --- Platform provider accounts
# A clinic's own verified connection is used when it has one, otherwise the account
# below. With neither, the call or job fails; nothing falls back to a test provider.
# Leave a key empty to offer no platform account for it.

# Twilio (AC followed by 32 hex characters, and its auth token).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Speech: STT_PROVIDER is deepgram or azure; TTS_PROVIDER is elevenlabs or azure.
STT_PROVIDER=deepgram
TTS_PROVIDER=elevenlabs
# Language multi (nova-3 only) follows a caller who mixes English and Hindi.
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=multi
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus
AZURE_SPEECH_LANGUAGE=en-US
AZURE_SPEECH_VOICE=en-US-JennyNeural
AZURE_HINDI_VOICE=hi-IN-SwaraNeural

# AI model. LLM_PROVIDER selects the platform account:
#   gemini      Google Gemini directly (GEMINI_API_KEY). Use a billing-enabled Google
#               project: free-tier prompts and replies are used by Google to improve its
#               products, which is not acceptable for patient calls.
#   openrouter  Models through OpenRouter (OPENROUTER_API_KEY), routed only to endpoints
#               that do not keep the conversation, cheapest first.
# Knowledge search embeds documents and questions with the same account.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# Empty uses the provider's default: gemini-3.8-flash, or google/gemini-3.8-flash on OpenRouter.
LLM_MODEL=
# Models a clinic may choose for its own AI-model connection.
TENANT_LLM_MODELS=gemini-3.8-flash,gemini-3.5-flash-lite,google/gemini-3.8-flash,google/gemini-3.5-flash-lite
# The deterministic safety rules always run. The semantic check adds one model request
# per caller turn; false skips it.
SAFETY_SEMANTIC_ENABLED=true

# --- Knowledge documents (local folder in development, S3 once deployed)
KNOWLEDGE_STORAGE_BACKEND=local
KNOWLEDGE_LOCAL_PATH=.local/knowledge-objects
KNOWLEDGE_S3_BUCKET=
KNOWLEDGE_S3_REGION=
KNOWLEDGE_S3_ENDPOINT=
# Optional S3 credentials; use IAM roles where available.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# --- Telemetry: traces and metrics go to an OTLP/HTTP collector only when this is set.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
