# Copy to .env and fill in your values; never commit .env.
ENVIRONMENT=local
LOG_LEVEL=INFO

# --- Database and Redis
# Containers reach PostgreSQL on the Windows host through host.docker.internal.
# For Python run on the host, use localhost instead (and localhost for Redis).
# Runtime login used by the API.
DATABASE_URL=postgresql+asyncpg://frontdesk_app:REPLACE_WITH_RUNTIME_PASSWORD@host.docker.internal:5432/frontdesk
# Schema owner; given only to the migration job and operator commands.
MIGRATION_DATABASE_URL=postgresql+asyncpg://postgres:REPLACE_WITH_OWNER_PASSWORD@host.docker.internal:5432/frontdesk
# Separate login for the background worker; never reuse the API or owner login.
WORKER_DATABASE_URL=postgresql+asyncpg://frontdesk_worker:REPLACE_WITH_WORKER_PASSWORD@host.docker.internal:5432/frontdesk
REDIS_URL=redis://redis:6379/0
# Connections per process: up to DB_POOL_SIZE + DB_MAX_OVERFLOW.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DEPENDENCY_TIMEOUT_SECONDS=2

# --- First super admin. Read only by the setup job; an existing account is never changed.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=Super Admin

# --- Keys. Inject from the deployment secret manager; required once deployed.
# Keyring for encrypted database fields: JSON {"key-id": "<base64 of 32 random bytes>"}.
# Generate a key: python -c "import base64,secrets;print(base64.b64encode(secrets.token_bytes(32)).decode())"
# Keep retired key IDs until nothing uses them; losing a key loses what it encrypted.
SECRET_ENCRYPTION_KEYS=
SECRET_ENCRYPTION_ACTIVE_KEY=
# An independent random value: python -c "import secrets;print(secrets.token_urlsafe(48))"
STREAM_TOKEN_KEY=

# --- Public addresses
# Frontend origin used in emailed links (HTTPS outside local/development).
TENANT_AUTH_PUBLIC_ORIGIN=
# Public HTTPS origin for Twilio webhooks, no trailing slash. Calls are answered once set.
TELEPHONY_PUBLIC_BASE_URL=

# --- Provider accounts and email
# Twilio, speech, the AI model and the email server are not set here. A platform
# administrator saves and verifies them in the product: Platform, Settings. A clinic
# may connect its own account; without one it is served by the platform's.

# The deterministic safety rules always run. The semantic check adds one model request
# per caller turn; false skips it.
SAFETY_SEMANTIC_ENABLED=true

# --- Knowledge documents (local folder in development, S3 once deployed)
KNOWLEDGE_STORAGE_BACKEND=local
KNOWLEDGE_LOCAL_PATH=.local/knowledge-objects
KNOWLEDGE_S3_BUCKET=
KNOWLEDGE_S3_REGION=
KNOWLEDGE_S3_ENDPOINT=
# Optional S3 credentials; use IAM roles where available.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# --- Telemetry: traces and metrics go to an OTLP/HTTP collector only when this is set.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
