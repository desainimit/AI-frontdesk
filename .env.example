# Copy to .env and use your installed PostgreSQL connection; never commit .env.
ENVIRONMENT=local
LOG_LEVEL=INFO
SERVICE_NAME=ai-frontdesk
# Replace username, URL-encoded password, port, and database with your local values.
# Containers connect to Windows PostgreSQL via host.docker.internal.
# For host Python, change host.docker.internal -> localhost and redis -> localhost.
DATABASE_URL=postgresql+asyncpg://frontdesk_app:REPLACE_WITH_RUNTIME_PASSWORD@host.docker.internal:5432/frontdesk
# Separate schema owner; provided only to migration jobs and operator CLI commands.
MIGRATION_DATABASE_URL=postgresql+asyncpg://postgres:REPLACE_WITH_OWNER_PASSWORD@host.docker.internal:5432/frontdesk
# Separate worker login for the background process; never reuse API/owner credentials.
WORKER_DATABASE_URL=postgresql+asyncpg://frontdesk_worker:REPLACE_WITH_WORKER_PASSWORD@host.docker.internal:5432/frontdesk
NOTIFICATION_PROVIDER=console
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_PROVIDER_TIMEOUT_SECONDS=10
OUTBOX_LEASE_SECONDS=90
OUTBOX_POLL_SECONDS=1
# Optional platform super-admin bootstrap. Set both fields to enable; no default password.
# Read only by the migration/bootstrap job. Existing accounts are never overwritten.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=Super Admin
REDIS_URL=redis://redis:6379/0
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=5
DB_POOL_RECYCLE_SECONDS=1800
DB_COMMAND_TIMEOUT_SECONDS=10
DEPENDENCY_TIMEOUT_SECONDS=2
REDIS_MAX_CONNECTIONS=20
RATE_LIMITS_ENABLED=false
# Tenant onboarding wizard backend: draft workspace + pending administrator. No API
# token is issued; access starts when the emailed invitation is accepted.
TENANT_ONBOARDING_ENABLED=false
# Tenant email/password login, invitations and OTP password reset. Requires the
# encryption keyring, OTP key, SMTP and the running worker (app.worker).
TENANT_HUMAN_AUTH_ENABLED=false
# Frontend origin used in invitation links (https outside local/development).
TENANT_AUTH_PUBLIC_ORIGIN=
# Keyring for encrypted database fields: JSON {"key-id": "<base64 of 32 random bytes>"}.
# Generate a key: python -c "import base64,secrets;print(base64.b64encode(secrets.token_bytes(32)).decode())"
# Inject from the deployment secret manager. Keep retired key IDs until re-encryption;
# losing a key makes every credential stored under it unrecoverable.
SECRET_ENCRYPTION_KEYS=
SECRET_ENCRYPTION_ACTIVE_KEY=
# Independent random values (python -c "import secrets;print(secrets.token_urlsafe(48))").
OTP_HMAC_KEY=
STREAM_TOKEN_KEY=
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
# starttls | tls | plain (plain is accepted only in local/development)
SMTP_TLS_MODE=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER=
SMTP_TIMEOUT_SECONDS=15
# Tenant-owned provider connections (Twilio, STT, TTS, LLM, embeddings). When true,
# calls and jobs use each tenant's own verified credentials and the provider keys in
# this file are used ONLY for the tenant IDs listed in LEGACY_PROVIDER_TENANT_IDS.
# A tenant with no connection and no allowlist entry fails closed. See
# docs/tenant-integrations.md before enabling.
TENANT_INTEGRATIONS_ENABLED=false
LEGACY_PROVIDER_TENANT_IDS=
TENANT_LLM_MODELS=gemini-3.8-flash,gemini-3.5-flash-lite
INTEGRATION_CACHE_SECONDS=15
INTEGRATION_VERIFY_TIMEOUT_SECONDS=8
TENANT_API_REQUESTS_PER_MINUTE=240
PLATFORM_API_REQUESTS_PER_MINUTE=120
WEBHOOK_REQUESTS_PER_CALL_PER_MINUTE=60
# Enable only with a reachable OTLP/HTTP collector; both traces and metrics export.
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_TRACE_SAMPLE_RATIO=0.1
OTEL_METRIC_EXPORT_INTERVAL_SECONDS=30

# Phase 5 inbound telephony & Twilio Media Streams
TELEPHONY_ENABLED=false
# Required when TELEPHONY_ENABLED=true: AC followed by 32 hex chars
TWILIO_ACCOUNT_SID=
# Auth token used for webhook signature verification and stream HMAC tokens
TWILIO_AUTH_TOKEN=
# Public HTTPS origin (e.g. https://your-domain.ngrok-free.app), no trailing slash
TELEPHONY_PUBLIC_BASE_URL=
# Silence timeout in seconds before closing idle media stream (5-120s, default 30)
TELEPHONY_IDLE_SECONDS=30
# Maximum call duration in seconds before terminating (30-3600s, default 600)
TELEPHONY_MAX_CALL_SECONDS=600

# Phase 6 STT & TTS Pipeline Configuration
# Mode: "echo" (Phase 5 bidirectional audio loopback) or "pipeline" (Phase 6 STT + TTS + Barge-in)
TELEPHONY_MODE=pipeline

# Provider selection ("deepgram", "azure", "mock", or "none" to disable fallback)
PRIMARY_STT_PROVIDER=deepgram
FALLBACK_STT_PROVIDER=azure
PRIMARY_TTS_PROVIDER=elevenlabs
FALLBACK_TTS_PROVIDER=azure

# Set true with Deepgram nova-3 / multi for English, Spanish, French, German, Portuguese, and Hindi calls
MULTILINGUAL_ENABLED=false

# Deepgram STT Configuration
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-2
DEEPGRAM_LANGUAGE=en
DEEPGRAM_BASE_URL=https://api.deepgram.com

# ElevenLabs TTS Configuration
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_OUTPUT_FORMAT=pcm_8000
ELEVENLABS_BASE_URL=https://api.elevenlabs.io

# Azure Cognitive Services Speech Configuration (shared for fallback STT and TTS)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus
AZURE_SPEECH_LANGUAGE=en-US
AZURE_SPEECH_VOICE=en-US-JennyNeural
AZURE_HINDI_VOICE=hi-IN-SwaraNeural
AZURE_SPEECH_OUTPUT_FORMAT=raw-8khz-16bit-mono-pcm

# Voice Timeouts & Circuit Breaker
STT_TIMEOUT_SECONDS=5.0
TTS_TIMEOUT_SECONDS=5.0
VOICE_CIRCUIT_BREAKER_FAILURES=3
VOICE_CIRCUIT_BREAKER_RESET_SECONDS=60.0

# Barge-In / Interruption Detection
BARGE_IN_ENABLED=true
BARGE_IN_ENERGY_THRESHOLD=400.0
BARGE_IN_CONSECUTIVE_FRAMES=2

# Phase 7 — Conversation State Configuration
CONVERSATION_STATE_TTL_SECONDS=3600
CONVERSATION_DEFAULT_LANGUAGE=en
CONVERSATION_LANGUAGE_CONFIDENCE_THRESHOLD=0.6
CONVERSATION_CONFIRMATION_TIMEOUT_SECONDS=120.0

# Agent runtime. LLM_PROVIDER=gemini uses Google Gemini; mock is for local/development only.
# Use a key from a billing-enabled Google project: free-tier prompts and replies are
# used by Google to improve its products, which is not acceptable for patient calls.
AGENT_ENABLED=false
LLM_PROVIDER=mock
GEMINI_API_KEY=
LLM_MODEL=gemini-3.8-flash
LLM_TIMEOUT_SECONDS=10
LLM_MAX_OUTPUT_TOKENS=2048
AGENT_MAX_STEPS=3
AGENT_MAX_TOOL_CALLS=4
AGENT_TURN_TIMEOUT_SECONDS=20
AGENT_TOOL_TIMEOUT_SECONDS=3

# Phase 11 knowledge base. Install pgvector in local PostgreSQL before migration.
# false disables uploads, processing, approval, and search; authorized list/version reads remain available.
KNOWLEDGE_ENABLED=false
KNOWLEDGE_STORAGE_BACKEND=local
KNOWLEDGE_LOCAL_PATH=.local/knowledge-objects
KNOWLEDGE_S3_BUCKET=
KNOWLEDGE_S3_REGION=
KNOWLEDGE_S3_ENDPOINT=
# Optional S3 credentials; use IAM roles where available.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Deterministic safety checks always run; semantic review uses the configured Gemini agent.
SAFETY_SEMANTIC_ENABLED=true
SAFETY_CLASSIFIER_TIMEOUT_SECONDS=2
