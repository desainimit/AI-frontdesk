# Copy to deploy/.env and fill in. Keep it out of version control and readable only by
# the operator. docs/runbook.md explains each value and how to generate the keys.

# --- Addresses (DNS for both must point at this server before the first start)
# Where people sign in.
APP_DOMAIN=app.example.com
# Where the phone service sends calls and texts.
API_DOMAIN=api.example.com

# --- Images, built from the two repositories (see the runbook)
BACKEND_IMAGE=frontdesk-api:1.0.0
WORKER_IMAGE=frontdesk-worker:1.0.0
WEB_IMAGE=frontdesk-web:1.0.0

# --- PostgreSQL 17 with the vector extension. Three logins, one database.
# URL-encode passwords. The setup job creates the two restricted logins from these.
# Schema owner: used by the setup job and by operator commands only.
MIGRATION_DATABASE_URL=postgresql+asyncpg://frontdesk_owner:CHANGE_ME@db.example.com:5432/frontdesk
# The API's login. Row-level security is enforced for it.
DATABASE_URL=postgresql+asyncpg://frontdesk_app:CHANGE_ME@db.example.com:5432/frontdesk
# The worker's login. It can read queues, not patient records.
WORKER_DATABASE_URL=postgresql+asyncpg://frontdesk_worker:CHANGE_ME@db.example.com:5432/frontdesk

# --- Keys. Generate each once; back them up apart from the database.
# {"k1": "<base64 of 32 random bytes>"}. Everything saved under Platform settings is
# encrypted with this. Lose it and those accounts must all be entered again.
SECRET_ENCRYPTION_KEYS=
SECRET_ENCRYPTION_ACTIVE_KEY=k1
# At least 43 random characters. Signs the audio stream of a call.
STREAM_TOKEN_KEY=
# 32 random bytes, base64. Encrypts the sign-in cookie of the website.
SESSION_ENCRYPTION_KEY=

# --- The first administrator. Read once by the setup job; an existing account is never changed.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=Super Admin

# --- Uploaded knowledge documents: an S3 bucket, or anything that speaks S3.
KNOWLEDGE_S3_BUCKET=
KNOWLEDGE_S3_REGION=
# Leave empty for AWS; set for another provider, such as https://<account>.r2.cloudflarestorage.com
KNOWLEDGE_S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Optional
LOG_LEVEL=INFO
# Traces and metrics go to an OTLP/HTTP collector only when this is set.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
